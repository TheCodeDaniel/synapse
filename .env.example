# Copy this file to `.env` (or export these in your shell) and fill in the
# key for whichever AI provider you configure in di.config.json (ai.provider).
# Never commit a real key — .env is already gitignored.
#
# ConfigLoader reads these automatically as a fallback whenever
# di.config.json's `ai.apiKey` is left blank, so you never have to put a
# real secret in a file that could get committed.

# Used when ai.provider is "anthropic"
ANTHROPIC_API_KEY=

# Used when ai.provider is "openai"
OPENAI_API_KEY=

# Used when ai.provider is "custom" (e.g. a self-hosted Qwen deployment
# behind an OpenAI-compatible gateway like vLLM or Ollama) — also requires
# ai.baseUrl to be set in di.config.json.
DI_CUSTOM_API_KEY=
