{
  "name": "@design-intelligence/vscode-extension",
  "version": "1.0.0",
  "description": "VS Code extension for Design Intelligence MCP",
  "displayName": "Design Intelligence",
  "publisher": "di-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheCodeDaniel/synapse"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "design-intelligence.importFigmaFile",
        "title": "Import Figma File",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.analyzeProject",
        "title": "Analyze Flutter Project",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.generatePlan",
        "title": "Generate Implementation Plan",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.generateUI",
        "title": "Generate UI Code",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.validateCode",
        "title": "Validate Generated Code",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.syncChanges",
        "title": "Sync Changes",
        "category": "Design Intelligence"
      }
    ],
    "views": {
      "design-intelligence": [
        {
          "type": "tree",
          "id": "di.projectBrowser",
          "name": "Projects"
        },
        {
          "type": "tree",
          "id": "di.planView",
          "name": "Implementation Plan"
        },
        {
          "type": "panel",
          "id": "di.outputPanel",
          "name": "Output"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "design-intelligence.importFigmaFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --watch",
    "test": "jest --coverage",
    "vscode:prepublish": "npm run build",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@design-intelligence/core": "*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "vscode": "^1.86.0"
  }
}