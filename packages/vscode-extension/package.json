{
  "name": "@design-intelligence/vscode-extension",
  "version": "1.0.0",
  "description": "VS Code extension for Design Intelligence MCP",
  "displayName": "Design Intelligence",
  "publisher": "di-mcp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheCodeDaniel/synapse"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "design-intelligence-container",
          "title": "Design Intelligence",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "design-intelligence-container": [
        {
          "type": "webview",
          "id": "design-intelligence.sidebar",
          "name": "Design Intelligence"
        }
      ]
    },
    "commands": [
      {
        "command": "design-intelligence.importFigmaFile",
        "title": "Import Figma File",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.analyzeProject",
        "title": "Analyze Flutter Project",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.generatePlan",
        "title": "Generate Implementation Plan",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.generateUI",
        "title": "Generate UI Code",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.validateCode",
        "title": "Validate Generated Code",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.syncChanges",
        "title": "Sync Changes",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.setFigmaToken",
        "title": "Set Figma Access Token",
        "category": "Design Intelligence"
      },
      {
        "command": "design-intelligence.setAiApiKey",
        "title": "Set AI Provider API Key",
        "category": "Design Intelligence"
      },
      {
        "command": "di.reload",
        "title": "Reload",
        "category": "Design Intelligence"
      }
    ]
  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --watch",
    "test": "jest --coverage --passWithNoTests",
    "vscode:prepublish": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@design-intelligence/core": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "vscode": "^1.86.0"
  }
}