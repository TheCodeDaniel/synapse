{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "--disable-extensions",
        "--disable-workspace-trust"
      ],
      //   "stopOnEntry": false,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
